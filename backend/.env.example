# TradePilot AI — backend environment configuration
# Copy to `.env` in the backend/ directory and adjust.

# Database connection. Default is SQLite at backend/tradepilot.db.
# For production use PostgreSQL, for example:
# DATABASE_URL=postgresql+psycopg2://tradepilot:password@localhost:5432/tradepilot
DATABASE_URL=sqlite:///./tradepilot.db

# Auth
# IMPORTANT: change this before deploying anywhere public.
JWT_SECRET=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# OpenAI (optional). When empty, YouTube analysis falls back to the
# deterministic parser + demo strategies — the demo works with no API keys.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Anthropic Claude (optional). Tried before OpenAI for YouTube analysis.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# ---- FREE AI alternatives (no credit card needed) ----
# Groq (free: 30 req/min, Llama 3.3 70B) — https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# Google Gemini (free: 15 req/min, Gemini 2.0 Flash) — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# TradingView webhook secret (sent as "secret" in alert JSON)
TRADINGVIEW_WEBHOOK_SECRET=tradepilot-webhook-secret

# Market data provider: "realtime" (default — Binance WebSocket for live crypto data),
# "binance" (Binance REST only), "simulated" (deterministic demo data), etc.
# With "realtime", the system streams live prices from Binance and evaluates
# strategies on every tick — signals fire in real-time.
MARKET_DATA_PROVIDER=realtime
BINANCE_BASE_URL=https://api.binance.com
BINANCE_CACHE_TTL=120

# Freshness window (seconds) for prices pushed by TradingView alert webhooks
# into the live-quote store (/market/live, live-stamped OHLCV, signal engine).
LIVE_QUOTE_TTL=300

# Comma separated list of allowed CORS origins (front-end domains)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,https://tradepilot-ai.vercel.app

# Environment: development | production
ENVIRONMENT=development
DEBUG=true

# Telegram notifications (optional) — sent when signals fire
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Auto-trading (the "monitor loop") ----
# AUTOTRADE_ENABLED starts/keeps the background scan engine running. Each scan
# evaluates enabled strategies against fresh market data, emits alerts and
# opens/closes PAPER positions. Live execution additionally requires Binance
# keys below AND an explicit per-strategy "arm" in the API/UI.
AUTOTRADE_ENABLED=true
AUTOTRADE_INTERVAL=120            # seconds between scans (>=30)
AUTOTRADE_PAPER_CAPITAL=10000     # default paper capital for new configs

# ---- Real execution (OPTIONAL — paper mode needs none of this) ----
# Generate trading-only Binance API keys (Spot trading permission; NO
# withdrawal/transfer permission) at https://www.binance.com/en/my/settings/api-management
BINANCE_API_KEY=
BINANCE_API_SECRET=

# ---- Firebase Cloud Messaging (push notifications) ----
# Path to Firebase service account JSON file. Get it from Firebase Console >
# Project Settings > Service Accounts > Generate New Private Key.
FIREBASE_CREDENTIALS_PATH=
FCM_ENABLED=false

# ---- Free market data providers ----
# Biquote (free, no API key needed) — real-time XAUUSD + 280+ forex pairs
# No config required, works automatically when MARKET_DATA_PROVIDER=biquote

# Finnhub (free API key at https://finnhub.io/register)
# 60 calls/min, WebSocket streaming, US stocks + forex + crypto
FINNHUB_API_KEY=

# OANDA (free demo account at https://oanda.com)
# Real-time forex + metals pricing, historical data since 2005, paper trading
OANDA_API_KEY=
OANDA_ACCOUNT_ID=
OANDA_ACCOUNT_TYPE=paper